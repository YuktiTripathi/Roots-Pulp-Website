# Public site origin.
NEXT_PUBLIC_SITE_URL=https://rootsandpulp.com

# [VERIFY] Google Business Profile URL
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# [VERIFY] Google Maps URL of the Business Profile
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# [VERIFY] Official Instagram. Hidden until set.
NEXT_PUBLIC_INSTAGRAM_URL=

# [VERIFY] Latitude and longitude from the Business Profile pin
NEXT_PUBLIC_CLINIC_LAT=
NEXT_PUBLIC_CLINIC_LNG=

# Live Google rating (homepage) and live Google reviews (Reviews page). Server only, never NEXT_PUBLIC_.
# Enable "Places API (New)" for the key; enabling the legacy "Places API" too adds up to 5 newest reviews.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional manual rating (for example 4.9), shown only when the live fetch is unavailable.
NEXT_PUBLIC_GOOGLE_RATING=
